-- ════════════════════════════════
--       TAB STRIP BUILDER
-- ════════════════════════════════
local Pages = {}
local ActivePage = nil

local function CreateStripTab(name, label, order)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(0, 95, 1, 0)
    Btn.BackgroundTransparency = 1
    Btn.Text = label
    Btn.TextColor3 = Color3.fromRGB(90, 90, 90)
    Btn.TextScaled = true
    Btn.Font = Enum.Font.GothamBold
    Btn.BorderSizePixel = 0
    Btn.LayoutOrder = order
    Btn.Parent = TabStrip

    local Underline = Instance.new("Frame")
    Underline.Size = UDim2.new(0.8, 0, 0, 2)
    Underline.Position = UDim2.new(0.1, 0, 1, -2)
    Underline.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Underline.BorderSizePixel = 0
    Underline.Visible = false
    Underline.Parent = Btn

    local Page = Instance.new("ScrollingFrame")
    Page.Name = name
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.BackgroundTransparency = 1
    Page.BorderSizePixel = 0
    Page.ScrollBarThickness = 3
    Page.ScrollBarImageColor3 = Color3.fromRGB(80, 80, 80)
    Page.Visible = false
    Page.Parent = PageHolder

    local Layout = Instance.new("UIListLayout")
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout.Padding = UDim.new(0, 0)
    Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    Layout.Parent = Page

    Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        Page.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y + 12)
    end)

    Btn.MouseButton1Click:Connect(function()
        if ActivePage then
            Pages[ActivePage].Page.Visible = false
            Pages[ActivePage].Btn.TextColor3 = Color3.fromRGB(90, 90, 90)
            Pages[ActivePage].Under.Visible = false
            TopLabel.Text = name:upper()
        end
        ActivePage = name
        Page.Visible = true
        Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        Underline.Visible = true
        TopLabel.Text = label:upper()
    end)

    Pages[name] = {Btn = Btn, Page = Page, Under = Underline}
    return Page
end

