--       LOOP FLING HEARTBEAT
-- ════════════════════════════════
RunService.Heartbeat:Connect(function()
    if not State.LoopFling then return end
    for _, p in pairs(Players:GetPlayers()) do
        if p==LocalPlayer then continue end
        local tr=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        local lr=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if tr and lr then
            lr.CFrame=tr.CFrame
            tr.Velocity=Vector3.new(math.random(-500,500),800,math.random(-500,500))
        end
    end
end)

-- ════════════════════════════════
--       FREE CAM HEARTBEAT
-- ════════════════════════════════
RunService.RenderStepped:Connect(function()
    if not State.FreeCAM then return end
    local spd = 0.8
    local cf = Camera.CFrame
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then Camera.CFrame=cf*CFrame.new(0,0,-spd) end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then Camera.CFrame=cf*CFrame.new(0,0,spd) end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then Camera.CFrame=cf*CFrame.new(-spd,0,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then Camera.CFrame=cf*CFrame.new(spd,0,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then Camera.CFrame=cf*CFrame.new(0,spd,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then Camera.CFrame=cf*CFrame.new(0,-spd,0) end
end)

