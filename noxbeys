--         ESP RENDER
-- ════════════════════════════════
local function InitESP(p)
    if p == LocalPlayer then return end
    local o = {}
    o.Box = Drawing.new("Square"); o.Box.Thickness=1.5; o.Box.Filled=false; o.Box.Color=Color3.new(1,1,1)
    o.BoxFill = Drawing.new("Square"); o.BoxFill.Thickness=1; o.BoxFill.Filled=true; o.BoxFill.Color=Color3.new(1,1,1); o.BoxFill.Transparency=0.88
    o.Name = Drawing.new("Text"); o.Name.Size=13; o.Name.Center=true; o.Name.Outline=true; o.Name.Color=Color3.new(1,1,1)
    o.Dist = Drawing.new("Text"); o.Dist.Size=11; o.Dist.Center=true; o.Dist.Outline=true; o.Dist.Color=Color3.fromRGB(180,180,180)
    o.HPBg = Drawing.new("Square"); o.HPBg.Filled=true; o.HPBg.Color=Color3.fromRGB(20,20,20)
    o.HP = Drawing.new("Square"); o.HP.Filled=true; o.HP.Color=Color3.fromRGB(200,200,200)
    o.Head = Drawing.new("Circle"); o.Head.Thickness=1.2; o.Head.Filled=false; o.Head.NumSides=20; o.Head.Color=Color3.new(1,1,1)
    o.Tracer = Drawing.new("Line"); o.Tracer.Thickness=1; o.Tracer.Transparency=0.4; o.Tracer.Color=Color3.new(1,1,1)
    State.ESPObjects[p] = o
end

local function RemoveESP(p)
    if State.ESPObjects[p] then
        for _, d in pairs(State.ESPObjects[p]) do pcall(function() d:Remove() end) end
        State.ESPObjects[p] = nil
    end
end

for _, p in pairs(Players:GetPlayers()) do InitESP(p) end
Players.PlayerAdded:Connect(InitESP)
Players.PlayerRemoving:Connect(RemoveESP)

RunService.RenderStepped:Connect(function()
    for _, p in pairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local o = State.ESPObjects[p]
        if not o then continue end
        local char = p.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not State.ESP or not root or not head or not hum or hum.Health<=0 then
            for _, d in pairs(o) do pcall(function() d.Visible=false end) end
            continue
        end
        local hp3, hv = Camera:WorldToViewportPoint(head.Position)
        local fp3 = Camera:WorldToViewportPoint(root.Position - Vector3.new(0,3,0))
        if not hv then for _, d in pairs(o) do pcall(function() d.Visible=false end) end continue end
        local sx,sy = hp3.X, hp3.Y
        local bx,by = fp3.X, fp3.Y
        local ht = math.abs(by-sy)
        local wd = ht*0.55
        local hr = math.max(4,ht*0.12)
        local lr = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local dist = lr and math.floor((lr.Position-root.Position).Magnitude) or 0
        local hpR = math.clamp(hum.Health/hum.MaxHealth,0,1)
        o.BoxFill.Position=Vector2.new(sx-wd/2,sy); o.BoxFill.Size=Vector2.new(wd,ht); o.BoxFill.Visible=true
        o.Box.Position=Vector2.new(sx-wd/2,sy); o.Box.Size=Vector2.new(wd,ht); o.Box.Visible=true
        o.Head.Position=Vector2.new(sx,sy-hr); o.Head.Radius=hr; o.Head.Visible=true
        o.Name.Text=p.DisplayName; o.Name.Position=Vector2.new(sx,sy-hr*2-3); o.Name.Visible=true
        o.Dist.Text=dist.."m"; o.Dist.Position=Vector2.new(sx,by+2); o.Dist.Visible=true
        local bX=sx-wd/2-7
        o.HPBg.Position=Vector2.new(bX-2,sy); o.HPBg.Size=Vector2.new(5,ht); o.HPBg.Visible=true
        o.HP.Position=Vector2.new(bX-2,sy+ht*(1-hpR)); o.HP.Size=Vector2.new(5,ht*hpR); o.HP.Visible=true
        o.Tracer.From=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y)
        o.Tracer.To=Vector2.new(bx,by); o.Tracer.Visible=true
    end
end)

-- ════════════════════════════════
--        AIMBOT RENDER
-- ════════════════════════════════
local AFOV = Drawing.new("Circle")
AFOV.Thickness=1; AFOV.Filled=false; AFOV.NumSides=64; AFOV.Color=Color3.fromRGB(180,180,180)

RunService.RenderStepped:Connect(function()
    AFOV.Position=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
    AFOV.Radius=State.AimbotFOV; AFOV.Visible=State.Aimbot
    if State.Aimbot and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local best,bd=nil,math.huge
        local ctr=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
        for _,p in pairs(Players:GetPlayers()) do
            if p==LocalPlayer then continue end
            local h=p.Character and p.Character:FindFirstChild(State.AimPart)
            if not h then continue end
            local s,v=Camera:WorldToViewportPoint(h.Position)
            if not v then continue end
            local d=(Vector2.new(s.X,s.Y)-ctr).Magnitude
            if d<State.AimbotFOV and d<bd then best=h;bd=d end
        end
        if best then
            Camera.CFrame=Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position,best.Position),State.AimbotSmoothing)
        end
    end
end)

