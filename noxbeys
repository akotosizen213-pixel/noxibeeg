local ActiveNav = nil
local NavButtons = {}

local function CreateNavBtn(label, targetPage, order)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, 28)
    Btn.BackgroundTransparency = 1
    Btn.Text = label
    Btn.TextColor3 = Color3.fromRGB(100, 100, 100)
    Btn.TextScaled = true
    Btn.Font = Enum.Font.Gotham
    Btn.BorderSizePixel = 0
    Btn.LayoutOrder = order
    Btn.Parent = NavList

    local Indicator = Instance.new("Frame")
    Indicator.Size = UDim2.new(0, 3, 0.6, 0)
    Indicator.Position = UDim2.new(0, 0, 0.2, 0)
    Indicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Indicator.BorderSizePixel = 0
    Indicator.Visible = false
    Indicator.Parent = Btn

    Btn.MouseButton1Click:Connect(function()
        if ActiveNav and NavButtons[ActiveNav] then
            NavButtons[ActiveNav].Btn.TextColor3 = Color3.fromRGB(100, 100, 100)
            NavButtons[ActiveNav].Ind.Visible = false
        end
        ActiveNav = label
        Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        Indicator.Visible = true

        -- Switch to the correct strip tab
        if Pages[targetPage] then
            Pages[targetPage].Btn.MouseButton1Click:Fire()
        end
    end)

    NavButtons[label] = {Btn = Btn, Ind = Indicator}
end

